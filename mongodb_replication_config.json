{
  "databasePairs": [
    {
      "source": {
        "connectionString": "mongodb://instance-1:27017/?replicaSet=rs0",
        "database": "test"
      },
      "target": {
        "connectionString": "mongodb://instance-1:27018/?replicaSet=rs1",
        "database": "test",
        "upsertMode": true,
        "collections": [
          {
            "sourceCollection": "customers",
            "targetCollection": "customers"
          },
          {
            "sourceCollection": "customers8",
            "targetCollection": "customers8"
          }
        ]
      }
    }
  ],
  "saveThreshold": 100000,
  "checkpointIntervalMinutes": 5,
  "forceOrderedOperations": false,
  "flushIntervalMs": 31,
  "targetMinPoolSize": 1024,
  "targetMaxPoolSize": 1024,

  "initialReadBatchSize": 12000,
  "initialWriteBatchSize": 100,
  "initialChannelBufferSize": 10,
  "initialMigrationWorkers": 8,
  "concurrentCollections": 4,
  
  "incrementalReadBatchSize": 8192,
  "incrementalWriteBatchSize": 16,
  "incrementalWorkerCount": 1024,
  "groupOpsByDistinctId": true,
  "incrementalIncomingQueueSize": 8192,
  "incrementalProcessingQueueSize": 4096,
  "statsIntervalMinutes": 1,
  
  "parallelReadsEnabled": true,
  "maxReadPartitions": 8,
  "minDocsPerPartition": 10000,
  "minDocsForParallelReads": 50000,
  "sampleSize": 1000,
  "workersPerPartition": 3,
  "backfillRampUp": {
    "enabled": true,
    "startQps": 2000.0,
    "rampRatePerMin": 10000.0,
    "updateIntervalMs": 1000,
    "useStaggeredWorkers": false,
    "workerDelayMs": 0
  },
  
  "retryConfig": {
    "maxRetries": 20,
    "baseDelayMs": 500,
    "maxDelayMs": 10000,
    "enableBatchSplitting": true,
    "minBatchSize": 10,
    "convertInvalidIds": true
  }
}
